# ============================================================================
# Local Media Plex, Emby & Jellyfin VideoWall Selector — Configuration (.env)
# Copy this file to .env and fill in your local media server details.
# ============================================================================

# Primary Media Server Backend: "plex", "emby", or "jellyfin"
MEDIA_PROVIDER=plex

# Base URL of your local Plex (:32400) or Emby / Jellyfin (:8096) server
MEDIA_URL=http://192.168.1.50:32400

# API Token:
#   - Plex:     X-Plex-Token (https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/)
#   - Emby:     Dashboard -> Advanced -> Api Keys -> New Api Key
#   - Jellyfin: Dashboard -> Administration -> API Keys -> +
MEDIA_TOKEN=YOUR_PLEX_OR_EMBY_API_TOKEN

# Optional: Specific movie library/section ID (leave blank to auto-discover all Movie libraries)
MEDIA_SECTION_ID=

# Optional: Direct local/NAS path rewrite so FFmpeg reads source files directly without HTTP overhead
# Format: <server_path_prefix>=<local_or_smb_path_prefix> (semicolon-separated for multiple)
# Example: MEDIA_PATH_MAP=/data/movies=\\nas\Movies
MEDIA_PATH_MAP=

# Optional: Add a second server simultaneously (e.g. run both Plex AND Emby/Jellyfin on one VideoWall!)
SECONDARY_MEDIA_PROVIDER=
SECONDARY_MEDIA_URL=
SECONDARY_MEDIA_TOKEN=

# VideoWall Server & Clip Storage Settings
WALL_DIR=./wall_data
HOST=0.0.0.0
PORT=18500
KIOSK_NAME=VideoWall Kiosk

# Optional substring to route browser hover audio to a specific HDMI/TV output (e.g. HDMI or LG)
AUDIO_SINK_MATCH=

# Responsive Grid Dimensions (auto-switches based on Portrait vs Landscape screen orientation)
PORTRAIT_COLS=5
PORTRAIT_ROWS=16
LANDSCAPE_COLS=8
LANDSCAPE_ROWS=9

# Pre-encoded Clip Parameters (40s scene extracted 35% into each movie at 216x120 24fps)
CLIP_DURATION_SEC=40
CLIP_SEEK_RATIO=0.35
TILE_WIDTH=216
TILE_HEIGHT=120
AUTO_GLIDE_IDLE_SEC=75

# Optional: Home Assistant Integration (for Google Cast / Smart TV auto-wake & casting)
HA_URL=
HA_TOKEN=
